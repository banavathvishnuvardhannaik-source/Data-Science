   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    'gender': ['male', 'female', 'male', 'female']\n",
    "})\n",
    "\n",
    "df['gender_num'] = df['gender'].map({\n",
    "    'male': 0,\n",
    "    'female': 1\n",
    "})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "d9588f0d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "   female  gender_num\n",
      "0    male           0\n",
      "1  female           1\n",
      "2    male           0\n",
      "3  female           1\n"
     ]
    }
   ],
   "source": [
    "df_renamed = df.rename(columns={\n",
    "    'gender': 'female'\n",
    "})\n",
    "\n",
    "print(df_renamed)"
   ]
  }
